# Ollama Configuration
# Local: OLLAMA_BASE_URL=http://localhost:11434
# Cloud: OLLAMA_BASE_URL=https://api.ollama.ai + set OLLAMA_API_KEY
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b
# Embeddings run locally via fastembed (BAAI/bge-base-en-v1.5) — no Ollama embed model needed.

# Qdrant Vector Store
# Leave blank for in-memory, set path for persistent, or set URL for Qdrant Cloud
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
